// secrets.h - nilai rahasia perangkat IoTMaxhub.
// Salin berkas ini menjadi secrets.h lalu ganti setiap nilai di bawah
// dengan nilai asli. secrets.h tidak pernah ikut git.
#pragma once

// Kunci bootstrap provisioning (header X-BOOTSTRAP-KEY ke /api/device/*).
#define BOOTSTRAP_KEY      "ISI_KUNCI_BOOTSTRAP_DI_SINI"

// Sandi WiFi AP recovery perangkat (minimal 8 karakter).
#define AP_PASS            "ISI_SANDI_AP"

// Sandi untuk menyimpan konfigurasi lewat portal AP.
#define CONFIG_ADMIN_PASS  "ISI_SANDI_PORTAL"
